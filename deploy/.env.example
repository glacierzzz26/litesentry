# litesentry 生产部署环境变量（deploy/docker-compose.yml 读取）。
# 复制为 deploy/.env 并填写，勿提交到版本库。

# Agent 共享 token（gRPC 上报鉴权；每台 Agent 的 LS_TOKEN 需与此一致）
LITESENTRY_TOKEN=change-me-to-a-long-random-token

# JWT 签名密钥（任意长随机串；改动会使已签发登录失效）
LITESENTRY_JWT_SECRET=change-me-to-a-long-random-secret

# 首个管理员（用户表为空时创建，首登强制改密；-prod 禁止 admin）
LITESENTRY_BOOTSTRAP_USER=admin
LITESENTRY_BOOTSTRAP_PASS=change-me-strong-password

# 可选：agent_id 白名单（逗号分隔；留空 = 不校验，仅依赖 token + mTLS）
# LITESENTRY_ALLOW_AGENTS=agent-1,agent-2
